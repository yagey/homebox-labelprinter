{
  "manifest_version": 3,
  "name": "Homebox Label Printer",
  "version": "1.3.0",
  "description": "Adds a Print Label button on Homebox location pages. Generates a half-page printable label (rotated for UPS pouch insertion) with a QR code, location name, full parent tree, and contents. Bulk mode fits 2 labels per sheet. Also auto-expands the locations tree.",
  "permissions": ["storage", "tabs", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/location/*",
        "https://*/location/*",
        "http://*/locations*",
        "https://*/locations*"
      ],
      "js": ["remove-pagination.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/location/*",
        "https://*/location/*",
        "http://*/locations*",
        "https://*/locations*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
