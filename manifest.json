{
  "manifest_version": 3,
  "name": "Homebox Label Printer",
  "version": "1.1.0",
  "description": "Adds a Print Label button on Homebox location pages. Generates a half-page printable label (rotated for UPS pouch insertion) with a QR code, location name, full parent tree, and contents. Bulk mode fits 2 labels per sheet. Also auto-expands the locations tree.",
  "permissions": ["storage", "tabs", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://localhost/*",
    "http://localhost:3100/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:3100/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3100/location/*",
        "http://localhost/location/*",
        "http://127.0.0.1:3100/location/*",
        "http://127.0.0.1/location/*",
        "http://localhost:3100/locations*",
        "http://localhost/locations*",
        "http://127.0.0.1:3100/locations*",
        "http://127.0.0.1/locations*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
